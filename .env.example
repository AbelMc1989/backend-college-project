# Окружение: development | testing | production
FLASK_ENV=development

# Секретный ключ для подписи JWT-токенов (в продакшене заменить на криптостойкую строку >= 32 байт)
JWT_SECRET_KEY=dev-secret-key-change-in-production-9f8a7b6c5d4e3f2a1b

# Время жизни токена доступа в часах
JWT_EXPIRATION_HOURS=24

# Подключение к БД:
# По умолчанию используется локальный SQLite-файл.
# Для перехода на PostgreSQL раскомментируйте строку ниже:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db
DATABASE_URL=sqlite:///ecommerce.db
